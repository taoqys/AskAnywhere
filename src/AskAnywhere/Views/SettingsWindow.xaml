<Window x:Class="AskAnywhere.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAnywhere 设置"
        Width="560" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFFFF"
        Foreground="#FF1F1F1F"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="520">
            <TextBlock Text="API 配置" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
            <TextBlock Text="Base URL（OpenAI 兼容接口地址）" Foreground="#FF5A5A5A"/>
            <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12" Padding="6,4" />
            <TextBlock Text="API Key" Foreground="#FF5A5A5A"/>
            <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,12" Padding="6,4" />
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="ModelFetchButton" DockPanel.Dock="Right" Content="获取模型列表" Click="ModelFetchButton_Click"
                        Padding="10,4" Style="{StaticResource ButtonDefault}" Margin="8,0,0,0"/>
                <TextBlock Text="模型（Model）" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
            </DockPanel>
            <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,4,0,12" Padding="6,4"
                      />

            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Temperature:" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
                <TextBlock x:Name="TempValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider x:Name="TempSlider" Minimum="0" Maximum="2" TickFrequency="0.1"
                        ValueChanged="TempSlider_ValueChanged"/>
            </DockPanel>

            <CheckBox x:Name="ThinkingCheck" Content="启用推理（DeepSeek 思考模式，思考内容会以灰色显示）"
                      Margin="0,4,0,6"/>
            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="推理强度：" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
                <ComboBox x:Name="ThinkingBudgetCombo" Width="140" HorizontalAlignment="Left"
                          />
            </DockPanel>

            <TextBlock Text="行为" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,10"/>
            <CheckBox x:Name="AutoSendCheck" Content="选中文字后自动发送（不勾选则用 ↑/↓ 选操作后回车发送）" Margin="0,0,0,8"/>
            <CheckBox x:Name="AutoHideCheck" Content="窗口失焦后自动隐藏" Margin="0,0,0,8"/>
            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,0,0,14"/>

            <TextBlock Text="联网搜索" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,10"/>
            <CheckBox x:Name="SearchCheck" Content="发送时自动联网搜索（聊天窗口底部可临时开关，单次生效）"
                      Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="搜索服务：" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
                <ComboBox x:Name="SearchProviderCombo" Width="160" HorizontalAlignment="Left"
                          SelectionChanged="SearchProviderCombo_SelectionChanged"/>
            </DockPanel>
            <StackPanel x:Name="SearchApiKeyPanel" Margin="0,0,0,10">
                <TextBlock Text="Tavily API Key（https://tavily.com 注册获取，有免费额度）" Foreground="#FF5A5A5A" TextWrapping="Wrap"/>
                <PasswordBox x:Name="SearchApiKeyBox" Margin="0,4,0,0" Padding="6,4"/>
            </StackPanel>
            <StackPanel x:Name="CustomSearchUrlPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="自定义搜索 URL（用 {query} 表示查询词，返回 Tavily 风格 JSON）" Foreground="#FF5A5A5A" TextWrapping="Wrap"/>
                <TextBox x:Name="CustomSearchUrlBox" Margin="0,4,0,0" Padding="6,4"/>
            </StackPanel>

            <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,10"/>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="触发键：" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
                <ComboBox x:Name="HotkeyKeyCombo" Width="120" HorizontalAlignment="Left"
                          />
            </DockPanel>
            <TextBlock Text="连按该键两次唤起窗口（下方为两次按下的最大间隔）" Foreground="#FF5A5A5A"/>
            <DockPanel Margin="0,4,0,14">
                <TextBlock x:Name="ThresholdValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider x:Name="ThresholdSlider" Minimum="100" Maximum="800" TickFrequency="50" IsSnapToTickEnabled="True"
                        ValueChanged="ThresholdSlider_ValueChanged"/>
            </DockPanel>

            <TextBlock Text="功能与提示词（每项都可编辑，包括内置）" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,8"/>
            <ListBox x:Name="ModesList" Height="96" SelectionChanged="ModesList_SelectionChanged"
                     />
            <DockPanel Margin="0,8,0,4">
                <TextBlock Text="名称：" VerticalAlignment="Center" Foreground="#FF5A5A5A" Width="40"/>
                <TextBox x:Name="ModeNameBox" Padding="6,4" 
                         TextChanged="ModeNameBox_TextChanged"/>
            </DockPanel>
            <TextBlock Text="提示词（system prompt）：" Foreground="#FF5A5A5A"/>
            <TextBox x:Name="ModePromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,4,0,6"
                      
                     Padding="6,4" TextChanged="ModePromptBox_TextChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="添加" Click="AddModeButton_Click" Padding="12,4" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0"/>
                <Button Content="删除所选" Click="RemoveModeButton_Click" Padding="12,4" Style="{StaticResource ButtonDefault}"/>
            </StackPanel>

            <TextBlock x:Name="SaveStatusText" Foreground="#FF1D8A4F" FontSize="11" Margin="0,10,0,0"
                       TextWrapping="Wrap" MaxHeight="32"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="保存" Click="SaveButton_Click" Padding="20,6" Style="{StaticResource ButtonPrimary}" Margin="0,0,10,0"/>
                <Button Content="取消" Click="CancelButton_Click" Padding="20,6" Style="{StaticResource ButtonDefault}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
