<Window x:Class="AskAnywhere.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAnywhere"
        Width="460" Height="620"
        MinWidth="360" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="#FFFFFFFF"
        Foreground="#FF1F1F1F"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <!--
      WindowChrome removes the DWM non-client frame that shows as a thin white
      strip on top of borderless windows. CaptionHeight=0 disables the system
      caption; edge resizing is still provided by ResizeBorderThickness.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FFE0E0E0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#FFF5F5F5" BorderThickness="0,0,0,1" BorderBrush="#FFE0E0E0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="#FF2563EB" VerticalAlignment="Center"/>
                        <TextBlock Text="AskAnywhere" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="历史" FontSize="11" Width="44" Click="HistoryButton_Click"
                            Style="{StaticResource IconButtonStyle}"/>
                    <Button Grid.Column="2" Content="&#x2699;" Click="SettingsButton_Click" Style="{StaticResource IconButtonStyle}"/>
                    <Button Grid.Column="3" Content="&#x2715;" Click="CloseButton_Click" Style="{StaticResource IconButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="2" Background="#FFFAFAFA" BorderThickness="0,1,0,0" BorderBrush="#FFE0E0E0">
                <StackPanel Margin="10,8">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="模式:" VerticalAlignment="Center" Foreground="#FF5A5A5A"/>
                        <ComboBox x:Name="ModeCombo" Margin="8,0,0,0" Width="120" HorizontalAlignment="Left"
                                  Background="#FFFFFFFF" Foreground="#FF1F1F1F"/>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="#FF6B6B6B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             Background="#FFFFFFFF" Foreground="#FF1F1F1F" BorderBrush="#FFD0D0D0"
                             CaretBrush="#FF1F1F1F" Padding="8,6" VerticalContentAlignment="Top"/>
                    <DockPanel Margin="0,6,0,0">
                        <CheckBox x:Name="TempThinkingCheck" DockPanel.Dock="Left" Content="推理"
                                  Foreground="#FF5A5A5A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送"
                                Click="SendButton_Click" Padding="14,6" Background="#FF1D4ED8"
                                Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="HintText" Text="Enter 发送 · Shift+Enter 换行 · Esc 隐藏"
                                   VerticalAlignment="Center" Foreground="#FF757575" FontSize="11"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
