<Window x:Class="AskAnywhere.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAnywhere"
        Width="480" Height="640"
        MinWidth="380" MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="#FFFFFFFF"
        Foreground="#FF1F1F1F"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <!--
      WindowChrome removes the DWM non-client frame that shows as a thin white
      strip on top of borderless windows. CaptionHeight=0 disables the system
      caption; edge resizing is still provided by ResizeBorderThickness.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF4A4A4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE8EAED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFDDE0E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FFE4E6EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Height="40" Background="#FFF7F8FA" BorderThickness="0,0,0,1" BorderBrush="#FFE4E6EB"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="#FF2563EB" VerticalAlignment="Center"/>
                        <TextBlock Text="AskAnywhere" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="历史" FontSize="11" Width="44" Click="HistoryButton_Click"
                            Style="{StaticResource IconButtonStyle}"/>
                    <Button Grid.Column="2" Content="&#x2699;" Click="SettingsButton_Click" Style="{StaticResource IconButtonStyle}"/>
                    <Button Grid.Column="3" Content="&#x2715;" Click="CloseButton_Click" Style="{StaticResource IconButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="12,10" Background="#FFFFFFFF">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="2" Background="#FFFAFAFC" BorderThickness="0,1,0,0" BorderBrush="#FFE4E6EB">
                <StackPanel Margin="12,10,12,10">
                    <!-- Mode + Model row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模式" VerticalAlignment="Center" Foreground="#FF6E6E6E" FontSize="12"/>
                        <ComboBox Grid.Column="1" x:Name="ModeCombo" Margin="8,0,14,0"/>
                        <TextBlock Grid.Column="2" Text="模型" VerticalAlignment="Center" Foreground="#FF6E6E6E" FontSize="12"/>
                        <ComboBox Grid.Column="3" x:Name="ModelCombo" IsEditable="True" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Input box -->
                    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="10,8"/>

                    <!-- Bottom row -->
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="FetchModelsButton" DockPanel.Dock="Left" Content="&#x27F3;" Width="30"
                                Padding="0" Margin="0,0,8,0" Style="{StaticResource ButtonDefault}"
                                Click="FetchModelsButton_Click" ToolTip="获取模型列表"/>
                        <CheckBox x:Name="TempThinkingCheck" DockPanel.Dock="Left" Content="推理"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送"
                                Click="SendButton_Click" Padding="16,6" Style="{StaticResource ButtonPrimary}"/>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="#FF6B6B6B" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HintText" Text="↑/↓ 切换功能 · Enter 发送" VerticalAlignment="Center"
                                   Foreground="#FF9A9A9A" FontSize="11"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
