<Window x:Class="AskAnywhere.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAnywhere"
        Width="460" Height="620"
        MinWidth="360" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="#FF1E1E1E"
        Foreground="#FFE8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#FF2B2B2B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="#FF2563EB" VerticalAlignment="Center"/>
                        <TextBlock Text="AskAnywhere" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2699;" Click="SettingsButton_Click" Style="{StaticResource IconButtonStyle}"/>
                    <Button Grid.Column="2" Content="&#x2715;" Click="CloseButton_Click" Style="{StaticResource IconButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="2" Background="#FF252525" BorderThickness="0,1,0,0" BorderBrush="#FF3A3A3A">
                <StackPanel Margin="10,8">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="模式:" VerticalAlignment="Center" Foreground="#FF9A9A9A"/>
                        <ComboBox x:Name="ModeCombo" Margin="8,0,0,0" Width="120" HorizontalAlignment="Left"
                                  Background="#FF252525" Foreground="White"/>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="#FF8A8A8A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             Background="#FF1E1E1E" Foreground="White" BorderBrush="#FF3A3A3A"
                             CaretBrush="White" Padding="8,6" VerticalContentAlignment="Top"
                             KeyDown="InputBox_KeyDown"/>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="ClearButton" Content="清空" Click="ClearButton_Click" Margin="0,0,8,0"
                                    Padding="10,4" Background="#FF3A3A3A" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="SettingsButton2" Content="设置" Click="SettingsButton_Click" Margin="0,0,8,0"
                                    Padding="10,4" Background="#FF3A3A3A" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="Ctrl+Enter 发送 · Esc 隐藏" VerticalAlignment="Center"
                                       Foreground="#FF8A8A8A" FontSize="11"/>
                        </StackPanel>
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送 (Ctrl+Enter)"
                                Click="SendButton_Click" Padding="14,6" Background="#FF2563EB"
                                Foreground="White" BorderThickness="0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
