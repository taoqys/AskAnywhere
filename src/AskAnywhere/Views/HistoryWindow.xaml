<Window x:Class="AskAnywhere.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAnywhere 历史记录"
        Width="680" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFFFF"
        Foreground="#FF1F1F1F"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <Button DockPanel.Dock="Top" Content="清空历史" Click="ClearHistoryButton_Click"
                    Padding="10,4" Background="#FFEDEDED" Foreground="#FF1F1F1F"
                    BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="会话列表" Foreground="#FF5A5A5A" Margin="0,0,0,6"/>
            <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged"
                     Background="#FFFFFFFF" BorderBrush="#FFD0D0D0"/>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="#FFD0D0D0" BorderThickness="1" Background="#FFFAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="DetailPanel"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
